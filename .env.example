# Public site URL (used by sitemap/robots/OG). Production: https://forzakarate.co.uk
NEXT_PUBLIC_SITE_URL=https://forzakarate.co.uk

# Club Honbu (Forza instance on Railway)
CLUB_HONBU_URL=https://forza-club-honbu-production.up.railway.app
# Must match WEBHOOK_SECRET on the Forza Club Honbu Railway service
CLUB_HONBU_WEBHOOK_SECRET=
NEXT_PUBLIC_CLUB_HONBU_API=https://forza-club-honbu-production.up.railway.app/api
NEXT_PUBLIC_FORZA_ADMIN_URL=https://forza-club-honbu-production.up.railway.app

# Contact form (Resend). RESEND_FROM must be on a verified domain.
RESEND_API_KEY=
RESEND_FROM=Forza Website <hello@forzakarate.co.uk>
CONTACT_TO_EMAIL=hello@forzakarate.co.uk

# Shop (leave unset until Stripe key is ready — do not commit secrets)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional AI assistants
GEMINI_API_KEY=

# REMOVED / DO NOT SET — gallery-proxy admin credentials are no longer used.
# FORZA_HONBU_ADMIN_USER=
# FORZA_HONBU_ADMIN_PASS=
# FORZA_HONBU_URL=
